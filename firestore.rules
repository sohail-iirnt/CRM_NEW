rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function activeUser() { return signedIn() && userDoc().data.active != false && userDoc().data.blocked != true; }
    function hasRole(name) { return activeUser() && (userDoc().data.role == name || (userDoc().data.accessRoles is list && name in userDoc().data.accessRoles)); }
    function admin() { return hasRole('admin'); }
    function ticketUser() { return hasRole('crm') || hasRole('warehouse') || hasRole('pdi') || hasRole('logistics') || admin(); }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create, update, delete: if admin();
    }

    match /tickets/{ticketId} {
      allow read: if ticketUser();
      allow create: if ticketUser();
      allow update: if ticketUser();
      allow delete: if admin();
    }

    match /workflowRules/{ruleId} { allow read: if signedIn(); allow write: if admin(); }
    match /settings/{settingId} { allow read: if signedIn(); allow write: if admin(); }

    match /inspectors/{inspectorId} {
      allow read: if hasRole('pdi') || admin();
      allow create, update: if hasRole('pdi') || admin();
      allow delete: if admin();
    }

    match /systemLogs/{logId} {
      allow read: if activeUser();
      allow create: if activeUser();
      allow update, delete: if false;
    }
  }
}
