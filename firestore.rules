rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function hasRole(name) {
      return signedIn() && userDoc().data.active == true && userDoc().data.blocked != true && (
        userDoc().data.role == name ||
        (userDoc().data.accessRoles is list && name in userDoc().data.accessRoles)
      );
    }
    function admin() { return hasRole('admin'); }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create, update, delete: if admin();
    }

    match /tickets/{ticketId} {
      allow read: if signedIn() && (
        admin() || hasRole('crm') || hasRole('warehouse') || hasRole('pdi') || hasRole('logistics')
      );
      allow create: if hasRole('crm') || admin();
      allow update: if admin()
        || (hasRole('crm') && resource.data.currentStatus == 'pending_warehouse' && request.resource.data.currentStatus == 'pending_warehouse')
        || (hasRole('warehouse') && resource.data.currentStatus == 'pending_warehouse' && (request.resource.data.currentStatus == 'ready_for_pdi' || request.resource.data.currentStatus == 'ready_for_dispatch'))
        || (hasRole('warehouse') && resource.data.currentStatus == 'ready_for_dispatch' && request.resource.data.currentStatus == 'logistics_pending')
        || (hasRole('pdi') && resource.data.currentStatus == 'ready_for_pdi' && request.resource.data.currentStatus == 'ready_for_dispatch')
        || (hasRole('logistics') && resource.data.currentStatus == 'logistics_pending' && request.resource.data.currentStatus == 'in_transit')
        || (hasRole('logistics') && resource.data.currentStatus == 'in_transit' && request.resource.data.currentStatus == 'closed');
      allow delete: if admin();
    }

    match /workflowRules/{ruleId} { allow read: if signedIn(); allow write: if admin(); }
    match /settings/{settingId} { allow read: if signedIn(); allow write: if admin(); }
    match /inspectors/{inspectorId} {
      allow read: if hasRole('pdi') || admin();
      allow create, update: if hasRole('pdi') || admin();
      allow delete: if admin();
    }
    match /systemLogs/{logId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
