rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function activeUser() { return signedIn() && userDoc().data.active != false && userDoc().data.blocked != true; }
    function roleMatches(value, name) { return value == name || (name == 'crm' && value == 'CRM') || (name == 'warehouse' && value == 'Warehouse') || (name == 'pdi' && value == 'PDI') || (name == 'logistics' && value == 'Logistics') || (name == 'admin' && value == 'Admin'); }
    function accessListHas(name) { return userDoc().data.accessRoles is list && (name in userDoc().data.accessRoles || (name == 'crm' && 'CRM' in userDoc().data.accessRoles) || (name == 'warehouse' && 'Warehouse' in userDoc().data.accessRoles) || (name == 'pdi' && 'PDI' in userDoc().data.accessRoles) || (name == 'logistics' && 'Logistics' in userDoc().data.accessRoles) || (name == 'admin' && 'Admin' in userDoc().data.accessRoles)); }
    function hasRole(name) { return activeUser() && (roleMatches(userDoc().data.role, name) || accessListHas(name)); }
    function admin() { return hasRole('admin'); }
    function ticketUser() { return hasRole('crm') || hasRole('warehouse') || hasRole('pdi') || hasRole('logistics') || admin(); }
    match /users/{uid} { allow read: if signedIn() && (request.auth.uid == uid || admin()); allow create: if admin(); allow update: if admin() || (signedIn() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt', 'updatedAt'])); allow delete: if admin(); }
    match /tickets/{ticketId} { allow read, create, update: if ticketUser(); allow delete: if admin(); }
    match /workflowRules/{ruleId} { allow read: if signedIn(); allow write: if admin(); }
    match /settings/{settingId} { allow read: if signedIn(); allow write: if admin(); }
    match /inspectors/{inspectorId} { allow read: if hasRole('pdi') || admin(); allow create, update, delete: if admin(); }
    match /etaRules/{ruleId} { allow read: if activeUser(); allow create, update, delete: if admin(); }
    match /systemLogs/{logId} { allow read, create: if activeUser(); allow update, delete: if false; }
  }
}
