rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function role(name) { return signedIn() && userDoc().data.role == name && userDoc().data.active == true; }
    function admin() { return role('admin'); }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create, update, delete: if admin();
    }

    match /tickets/{ticketId} {
      allow read: if signedIn();
      allow create: if role('crm') || admin();
      allow update: if admin()
        || (role('crm') && resource.data.currentStatus == 'pending_warehouse' && request.resource.data.currentStatus == 'pending_warehouse')
        || (role('warehouse') && resource.data.currentStatus == 'pending_warehouse' && (request.resource.data.currentStatus == 'ready_for_pdi' || request.resource.data.currentStatus == 'ready_for_dispatch'))
        || (role('warehouse') && resource.data.currentStatus == 'ready_for_dispatch' && request.resource.data.currentStatus == 'logistics_pending')
        || (role('pdi') && resource.data.currentStatus == 'ready_for_pdi' && request.resource.data.currentStatus == 'ready_for_dispatch')
        || (role('logistics') && resource.data.currentStatus == 'logistics_pending' && request.resource.data.currentStatus == 'in_transit')
        || (role('logistics') && resource.data.currentStatus == 'in_transit' && request.resource.data.currentStatus == 'closed');
      allow delete: if admin();
    }

    match /workflowRules/{ruleId} { allow read: if signedIn(); allow write: if admin(); }
    match /settings/{settingId} { allow read: if signedIn(); allow write: if admin(); }
    match /systemLogs/{logId} { allow create: if signedIn(); allow read: if admin(); allow update, delete: if false; }
  }
}
